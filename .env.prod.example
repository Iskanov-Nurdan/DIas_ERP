# ─────────── DIAS · production ───────────
# cp .env.prod.example .env.prod  и заполните значения. Файл в git не коммитится.

# ——— Django ———
# Сгенерировать: docker compose -f docker-compose.prod.yml run --rm backend \
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=erp.example.com,www.erp.example.com

# ——— PostgreSQL (host/port задаются в compose: db:5432) ———
PGDATABASE=dias
PGUSER=dias_user
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD

# ——— Redis (Channels) — задаётся в compose, переопределять не нужно ———
# REDIS_URL=redis://redis:6379/0

# ——— CORS / WebSocket: строгий whitelist origin'ов фронта ———
CORS_ALLOWED_ORIGINS=https://erp.example.com
WEBSOCKET_ALLOWED_ORIGINS=https://erp.example.com

# ——— Инициализация (только первый запуск стенда) ———
# 1 — создаст роли и суперпользователя admin/admin. В проде держите 0.
RUN_SEED_ROLES=0
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1

# ——— Накладные ———
WAYBILL_SUPPLIER_NAME=
WAYBILL_SUPPLIER_PHONE=

# ——— Фронтенд ———
# Каталог на сервере с ГОТОВЫМ билдом SPA (index.html внутри) — монтируется в nginx.
# Заливается отдельно: rsync -az --delete build/ root@<сервер>:/opt/dias/frontend-dist/
# Не указывайте ./frontend — это исходники из git, залитый билд сломает git pull.
FRONTEND_DIST=./frontend-dist

# ——— Прочее ———
TZ=Europe/Moscow
HTTP_PORT=80

# ——— TLS ———
# True — только после подключения HTTPS (secure cookies + редирект + HSTS)
SECURE_COOKIES=False
# CSRF_TRUSTED_ORIGINS=https://erp.example.com
