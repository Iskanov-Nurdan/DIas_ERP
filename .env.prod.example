# ─────────── DIAS · production (diass.tw1.ru) ───────────
# cp .env.prod.example .env.prod  и заполните значения. Файл в git не коммитится.
# Все команды compose — только с --env-file .env.prod (или через make).

# ——— Django ———
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=diass.tw1.ru

# ——— PostgreSQL (host/port задаются в compose: db:5432) ———
PGDATABASE=dias
PGUSER=dias_user
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD

# ——— CORS / WebSocket: origin'ы фронта ———
# Фронт на том же домене — CORS для него не нужен; localhost:3000 — для локальной разработки против прода.
CORS_ALLOWED_ORIGINS=https://diass.tw1.ru,http://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=https://diass.tw1.ru,http://localhost:3000

# ——— Инициализация ———
# 1 — создаст роли и суперпользователя admin/admin. Только на пустой БД, потом верните 0.
RUN_SEED_ROLES=0
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1

# ——— Накладные ———
WAYBILL_SUPPLIER_NAME=
WAYBILL_SUPPLIER_PHONE=

# ——— Фронтенд ———
# Каталог на сервере с ГОТОВЫМ билдом (index.html внутри), монтируется в nginx.
# Заливается с локальной машины: scp -r build/* root@<сервер>:/root/DIas_ERP/frontend-dist/
FRONTEND_DIST=./frontend-dist

# ——— Сеть ———
# Контейнерный nginx слушает только localhost: снаружи его проксирует системный nginx с TLS.
HTTP_PORT=127.0.0.1:8080
TZ=Europe/Moscow

# ——— TLS ———
SECURE_COOKIES=True
CSRF_TRUSTED_ORIGINS=https://diass.tw1.ru
